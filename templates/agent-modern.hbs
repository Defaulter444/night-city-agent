<div class="nca nca-modern nca-os {{#if osCompact}}os-compact{{/if}} {{#if osReducedMotion}}os-reduced-motion{{/if}}">
{{#if locked}}<div class="nca-empty"><h2>Хранилище закрыто</h2><p>Контакты и переписка сохранены. Импортируйте файл восстановления.</p><button data-action="data">Открыть данные</button></div>{{else}}
{{#if noGM}}<div class="nca-warn">Нет сигнала: мастер не в игре. Черновик остаётся в открытом окне.</div>{{/if}}
<header class="nca-top"><div class="nca-brand"><i class="fa-solid fa-mobile-screen-button" aria-hidden="true"></i><div><strong>АГЕНТ</strong><span>НАЙТ-СИТИ · ЛИЧНАЯ СВЯЗЬ</span></div></div>
{{#if device}}<button class="nca-number" data-action="copyNum" aria-label="Скопировать мой номер" title="Скопировать мой номер"><span class="nca-device-label">{{device.label}}</span><span>{{device.num}} <i class="fa-regular fa-copy" aria-hidden="true"></i></span></button>{{/if}}
<button data-action="conferences" aria-label="Конференции" title="Конференции"><i class="fa-solid fa-users"></i></button>
<button class="nca-files-button" data-action="files"><i class="fa-regular fa-folder-open" aria-hidden="true"></i> Файлы</button>
{{#if ringing}}<button data-action="mute" aria-label="Заглушить звонок" title="Заглушить звонок"><i class="fa-solid fa-bell-slash"></i> Звонит</button>{{/if}}
<details class="nca-menu"><summary aria-label="Меню Агента"><i class="fa-solid fa-ellipsis"></i></summary><div><button data-action="newNote">Создать заметку</button><button data-action="notes">Личный журнал</button><button data-action="emergency">Экстренные службы</button><button data-action="pickRingtone">Выбрать рингтон</button>{{#if hasOwnRingtone}}<button data-action="resetRingtone">Вернуть общий рингтон</button>{{/if}}{{#if isGM}}<button data-action="data">Данные и резервные копии</button>{{/if}}<button data-action="help">Руководство</button></div></details></header><div class="os-systembar"><span>{{osStatus}}</span><span>AGENT OS · 0.16</span></div>
{{#if manyDevices}}<div class="nca-devbar" aria-label="Устройства">{{#each devices}}<button class="nca-dev {{#if selected}}on{{/if}}" data-action="pickDevice" data-num="{{num}}"><b>{{label}}</b><span>{{num}}</span></button>{{/each}}</div>{{/if}}
{{#if noDevice}}<div class="nca-empty"><h2>Ваш Агент ещё не выдан</h2><p>Попросите мастера назначить вам устройство.</p><button data-action="help">Открыть руководство</button></div>{{else}}
{{#if osMessages}}<div class="nca-body"><aside class="nca-side"><div class="nca-sidehead"><h2>Сообщения <span class="nca-count">{{contactCount}}</span></h2><button data-action="mailing" aria-label="Рассылка сообщения" title="Рассылка сообщения"><i class="fa-solid fa-envelopes-bulk"></i></button><button data-action="newContact" aria-label="Новый контакт" title="Новый контакт"><i class="fa-solid fa-plus"></i></button></div>
<label class="nca-searchbox"><i class="fa-solid fa-magnifying-glass"></i><input class="nca-search" type="search" value="{{search}}" placeholder="Контакт или сообщение" aria-label="Поиск контактов и сообщений"></label>
<ul class="nca-contacts">{{#each contacts}}<li data-search="{{searchText}}"><button class="nca-contact {{#if selected}}on{{/if}}" data-action="pickContact" data-num="{{num}}" aria-pressed="{{selected}}">{{#if avatar}}<img class="os-chat-avatar" src="{{avatar}}" alt="">{{/if}}<span class="row"><span class="name">{{name}}</span>{{#if unread}}<span class="badge" aria-label="Непрочитанных сообщений: {{unread}}">{{unread}}</span>{{/if}}</span><span class="subnum">{{num}}</span><span class="preview">{{preview}}</span><span class="nca-tags">{{#each tags}}<small>{{this}}</small>{{/each}}</span></button></li>{{else}}<li class="nca-empty small">Добавьте первый контакт кнопкой «+».</li>{{/each}}<li class="nca-search-empty" role="status" hidden>Контакты не найдены. Попробуйте другое имя или номер.</li></ul><div class="nca-sidefoot"><i class="fa-solid {{#if noGM}}fa-signal{{else}}fa-circle{{/if}}" aria-hidden="true"></i> {{#if noGM}}Мастер не в игре{{else}}На связи{{/if}}</div></aside>
<section class="nca-main">{{#if active}}<div class="nca-head">{{#if osActiveAvatar}}<img class="os-avatar" src="{{osActiveAvatar}}" alt="">{{/if}}<div class="nca-who"><strong>{{activeName}}</strong><span>{{active}}</span></div><button data-action="osAction" data-os="call" data-num="{{active}}" title="Позвонить" aria-label="Позвонить"><i class="fa-solid fa-phone"></i></button><button class="nca-pins-toggle" data-action="pins" aria-label="Показать закреплённые сообщения" title="Показать закреплённые сообщения" aria-pressed="{{onlyPins}}"><i class="fa-solid fa-thumbtack"></i><span>Закреплённые</span></button><details class="nca-menu"><summary aria-label="Действия с контактом"><i class="fa-solid fa-ellipsis"></i></summary><div><label>Имя в вашей книге<input class="nca-name" type="text" value="{{activeBookName}}" placeholder="Имя контакта"></label><button data-action="saveName">Сохранить имя</button><button data-action="tags">Метки контакта</button><button data-action="shareContact">Поделиться контактом</button><button data-action="payEb">Перевести эдди</button></div></details></div>
{{#if tags}}<div class="nca-active-tags nca-tags">{{#each tags}}<small>{{this}}</small>{{/each}}</div>{{/if}}
{{#if onlyPins}}<div class="nca-filter-note"><i class="fa-solid fa-thumbtack" aria-hidden="true"></i> Только закреплённые <button data-action="pins">Вся переписка</button></div>{{/if}}
<div class="nca-thread" role="log" aria-label="Переписка" tabindex="0">{{#each messages}}<div class="nca-msg {{#if mine}}mine{{/if}}" data-search="{{text}} {{documentTitle}} {{contact.name}}" data-pinned="{{pinned}}"><div class="bubble">
{{#if image}}<button class="nca-image-button" data-action="openImage" data-src="{{image}}" aria-label="Открыть изображение" title="Открыть изображение"><img class="nca-photo" src="{{image}}" alt="Вложение"></button>{{/if}}
{{#if documentId}}<button class="nca-file-link" data-action="openDocument" data-id="{{documentId}}"><i class="fa-regular fa-file-lines" aria-hidden="true"></i><span><small>Документ</small><strong>{{documentTitle}}</strong></span><i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i></button>{{/if}}
{{#if contact}}<div class="nca-contact-card"><strong>{{contact.name}}</strong><span>{{contact.num}}</span>{{#unless mine}}<button data-action="acceptContact" data-index="{{index}}">Добавить контакт</button>{{/unless}}</div>{{/if}}
<span class="nca-message-text">{{text}}</span><div class="nca-message-meta"><time title="{{timeTitle}}">{{#if aloud}}<span class="aloud" title="Рядом стоящие слышали">вслух · </span>{{/if}}{{time}}</time><button data-action="pin" data-index="{{index}}" aria-label="Закрепить или открепить" title="Закрепить или открепить" aria-pressed="{{pinned}}"><i class="fa-solid fa-thumbtack"></i>{{#if pinned}} закреплено{{/if}}</button></div></div></div>{{else}}<div class="nca-empty"><h2>Начните разговор</h2><p>Сообщения останутся в истории этого контакта.</p></div>{{/each}}<div class="nca-filter-empty" role="status" hidden></div></div>
{{#if aloud}}<div class="nca-aloud-note"><i class="fa-solid fa-volume-high"></i> Внутренний Агент без хирона: сообщения проговариваются вслух.</div>{{/if}}
<div class="nca-compose"><textarea class="nca-input" rows="2" maxlength="2000" aria-label="Сообщение" placeholder="Написать сообщение…">{{draft}}</textarea><button data-action="sendImage" aria-label="Приложить изображение" title="Приложить изображение"><i class="fa-regular fa-image"></i></button><button data-action="files" aria-label="Приложить файл" title="Приложить файл"><i class="fa-solid fa-paperclip"></i></button><button class="nca-primary" data-action="send" aria-label="Отправить · Enter" title="Отправить · Enter"><i class="fa-solid fa-arrow-up"></i><span>Отправить</span></button></div>
{{else}}<div class="nca-empty"><i class="fa-regular fa-comments"></i><h2>На связи с Найт-Сити</h2><p>Выберите контакт или начните новый разговор.</p></div>{{/if}}</section></div>{{else}}<main class="os-page">{{{osContent}}}<p class="os-no-results" role="status" hidden>Ничего не найдено. Измените запрос.</p></main>{{/if}}<nav class="os-nav" aria-label="Разделы Агента">{{{osNav}}}</nav>{{/if}}{{/if}}
</div>
